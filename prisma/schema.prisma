generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  classLevel   Int
  avatar       String?
  xp           Int      @default(0)
  level        Int      @default(1)
  createdAt    DateTime @default(now())
  chats        SparkChat[]
  logs         AIGenerationLog[]
  safetyLogs   SafetyLog[]
  quizzes      Quiz[]
  attempts     QuizAttempt[]
  xpHistory    XPHistory[]
  userBadges   UserBadge[]
  progress     MaterialProgress[]
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  materials   CurriculumMaterial[]
  quizzes     Quiz[]
  paths       LearningPath[]
  createdAt   DateTime @default(now())
}

model LearningPath {
  id          String       @id @default(cuid())
  subjectId   String
  subject     Subject      @relation(fields: [subjectId], references: [id])
  classLevel  Int
  title       String
  description String?
  order       Int
  nodes       LessonNode[]
  createdAt   DateTime     @default(now())

  @@unique([subjectId, classLevel, order])
  @@index([classLevel])
}

model LessonNode {
  id        String       @id @default(cuid())
  pathId    String
  path      LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  order     Int
  chapter   Int
  title     String
  objective String?
  topic     String
  createdAt DateTime     @default(now())

  @@unique([pathId, order])
}

model CurriculumMaterial {
  id                String   @id @default(cuid())
  subjectId         String
  subject           Subject  @relation(fields: [subjectId], references: [id])
  classLevel        Int
  topic             String
  learningObjective String?
  title             String
  content           String
  example           String
  summary           String
  createdAt         DateTime @default(now())
  quizzes           Quiz[]
  progress          MaterialProgress[]

  @@unique([subjectId, classLevel, topic])
  @@index([classLevel])
}

model SparkChat {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String
  content   String
  blocked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AIGenerationLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  type       String
  prompt     String
  response   String?
  model      String   @default("openai")
  status     String
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([type, status])
}

model SafetyLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  stage     String
  content   String
  reason    String
  createdAt DateTime @default(now())

  @@index([stage])
}

model Quiz {
  id          String              @id @default(cuid())
  subjectId   String
  subject     Subject             @relation(fields: [subjectId], references: [id])
  materialId  String?
  material    CurriculumMaterial? @relation(fields: [materialId], references: [id])
  classLevel  Int
  topic       String
  difficulty  String
  createdBy   String
  createdByUser User              @relation(fields: [createdBy], references: [id])
  createdAt   DateTime            @default(now())
  questions   QuizQuestion[]
  attempts    QuizAttempt[]

  @@index([subjectId, classLevel])
}

model QuizQuestion {
  id            String  @id @default(cuid())
  quizId        String
  quiz          Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order         Int
  question      String
  options       String
  correctIndex  Int
  explanation   String

  answers       QuizAnswer[]

  @@unique([quizId, order])
}

model QuizAttempt {
  id            String    @id @default(cuid())
  quizId        String
  quiz          Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  status        String    @default("in_progress")
  score         Int?
  totalQuestions Int
  correctCount  Int?
  xpAwarded     Int       @default(0)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  answers       QuizAnswer[]

  @@index([userId, status])
}

model QuizAnswer {
  id            String        @id @default(cuid())
  attemptId     String
  attempt       QuizAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      QuizQuestion  @relation(fields: [questionId], references: [id])
  selectedIndex Int
  isCorrect     Boolean

  @@unique([attemptId, questionId])
}

model MaterialProgress {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  materialId  String
  material    CurriculumMaterial @relation(fields: [materialId], references: [id])
  completedAt DateTime          @default(now())

  @@unique([userId, materialId])
}

model XPHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  source    String
  reason    String
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Badge {
  id          String      @id
  name        String
  description String
  icon        String
  userBadges  UserBadge[]
}

model UserBadge {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  badgeId String
  badge   Badge    @relation(fields: [badgeId], references: [id])
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
}
